{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.venv/**",
      "!**/.devenv/**",
      "!**/.direnv/**",
      "!**/.claude/**",
      "!**/.complexipy_cache/**",
      "!**/.import_linter_cache/**",
      "!**/__pycache__/**",
      "!**/dist/**",
      "!**/build/**",
      "!**/.next/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
